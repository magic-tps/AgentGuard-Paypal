# Public Render + Neon: supply values only in the hosting environment. Never overwrite an existing .env.
# PostgreSQL connection supplied by Neon; retain its TLS/sslmode parameters.
DATABASE_URL=
# Explicit public non-AI fallback. Requires DEMO_MODE=true; remote login is still mandatory.
AI_PROVIDER=deterministic
# For LOCAL real inference only, select AI_PROVIDER=ollama and a downloaded model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=180000
# Optional only when AI_PROVIDER=openai. No paid provider is required.
OPENAI_API_KEY=
OPENAI_MODEL=
# Both Sandbox credentials or neither (neither means labeled simulation with DEMO_MODE=true).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set after registering the public HTTPS endpoint in the same Sandbox REST app.
PAYPAL_WEBHOOK_ID=
# Public HTTPS origin, no path/query. Local demo may explicitly use http://localhost:3000.
NEXT_PUBLIC_APP_URL=
DEMO_MODE=true
# Required for remote access: at least 12 password characters, 32 session-secret characters.
OPERATOR_PASSWORD=
SESSION_SECRET=
